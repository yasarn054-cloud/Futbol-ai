*{box-sizing:border-box}
body{margin:0;background:#0b1220;color:#edf2f7;font-family:Arial,sans-serif}
.wrap{max-width:760px;margin:auto;padding:20px 15px}
header{display:flex;align-items:center;gap:12px;margin-bottom:22px}
.logo{font-size:30px;background:#1c2a40;padding:12px;border-radius:15px}
h1{font-size:24px;margin:0}
header p,.muted,footer{color:#9aa9bd;font-size:13px}
.tag{margin-left:auto;background:#153b32;color:#7ee2b8;padding:7px 10px;border-radius:30px}
.panel,.match{background:#131f31;border:1px solid #26364c;border-radius:17px;padding:17px;margin-bottom:13px}
label{display:block;margin-bottom:8px;color:#b7c5d7}
input{width:100%;padding:13px;border-radius:10px;background:#0c1727;color:white;font-size:16px}
button{width:100%;padding:15px;margin-top:13px;background:#3b82f6;color:white;border:0;border-radius:11px;font-weight:bold}
.message{padding:10px 2px;color:#b7c5d7}
.match h3{font-size:16px}
.meta{font-size:12px;color:#9aa9bd}
.pick{display:inline-block;background:#203d64;padding:7px;border-radius:8px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.stat{background:#0c1727;padding:9px;border-radius:9px;text-align:center;font-size:12px}
.stat b{display:block;color:white;font-size:17px}
footer{text-align:center;padding:20px}
